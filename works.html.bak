<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Works</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <h1 class="site-title" id="site-title">My Photography</h1>
        <nav class="top-nav" id="top-nav"></nav>
      </div>
    </header>

    <main class="container" id="main-content">
      <h2 class="page-title">Works</h2>
      <p class="page-subtitle">Series Index (auto from images folders)</p>
      <ul class="series-list" id="series-list"></ul>
    </main>

    <script src="site-config.js"></script>
    <script src="app.js"></script>
    <script>
      window.PortfolioApp.initHeader();
      window.PortfolioApp.loadSeriesList();
    </script>
  </body>
</html>
